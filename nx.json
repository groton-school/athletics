{
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist"]
    },
    "release": {
      "cache": true,
      "dependsOn": ["^release"],
      "outputs": ["{projectRoot}/package.json", "{projectRoot}/CHANGELOG.md"]
    },
    "service": {
      "cache": true,
      "dependsOn": ["^service"],
      "outputs": ["{projectRoot}/deploy"]
    }
  }
}
