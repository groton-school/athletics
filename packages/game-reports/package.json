{
  "name": "@groton/game-reports",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "run-s clean:*",
    "clean:next": "del ./next",
    "clean:scripts": "del ./build",
    "dev": "next dev",
    "build": "run-s build:*",
    "build:clean": "del ./build",
    "build:scripts": "tsc -p ./tsconfig.scripts.json",
    "build:compile": "next build --debug",
    "service": "run-s service:*",
    "service:clean": "del ./deploy",
    "service:build": "run-s build",
    "service:prune": "pnpm -F @groton/game-reports deploy --prod ./deploy",
    "service:game-reports": "./scripts/deploy gameReports -v ./deploy",
    "gcp-build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@battis/lazy-secrets": "catalog:prod",
    "@groton/colors": "^0.4.3",
    "@groton/veracross-api": "catalog:prod",
    "@types/bootstrap": "^5.2.11",
    "@types/node": "catalog:prod",
    "@types/react": "catalog:prod",
    "@types/react-dom": "catalog:prod",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.2",
    "next": "catalog:prod",
    "next-auth": "^5.0.0-beta.32",
    "openid-client": "catalog:prod",
    "react": "catalog:prod",
    "react-bootstrap": "^2.10.10",
    "react-bootstrap-icons": "^1.11.6",
    "react-dom": "catalog:prod",
    "temporal-polyfill": "catalog:prod",
    "zod": "^4.6.7",
    "zod-form-data": "^3.0.4"
  },
  "devDependencies": {
    "@1password/sdk": "catalog:dev",
    "@battis/descriptive-types": "catalog:dev",
    "@battis/partly-gcloudy": "catalog:dev",
    "@battis/typescript-tricks": "catalog:dev",
    "@battis/workspace": "catalog:dev",
    "@qui-cli/colors": "catalog:dev",
    "@qui-cli/core": "catalog:dev",
    "@qui-cli/env": "catalog:dev",
    "@qui-cli/log": "catalog:dev",
    "@qui-cli/plugin": "catalog:dev",
    "@qui-cli/structured": "catalog:dev",
    "@tsconfig/node-lts": "catalog:dev",
    "del-cli": "catalog:dev",
    "eslint-config-next": "catalog:dev",
    "npm-run-all": "catalog:dev",
    "typescript": "catalog:dev"
  }
}
