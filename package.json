{
  "name": "@groton/athletics",
  "version": "0.0.0",
  "homepage": "https://github.com/groton-school/athletics#readme",
  "repository": {
    "type": "git",
    "url": "git@github.com:groton-school/athletics.git"
  },
  "license": "GPL-3.0-only",
  "author": {
    "name": "Seth Battis",
    "email": "sbattis@groton.org"
  },
  "type": "module",
  "scripts": {
    "build": "run-s build:*",
    "build:clean": "del ./build",
    "build:compile": "tsc",
    "build:turbo": "turbo build",
    "build:paths": "monorepo-package-paths -f --author --homepage --repository",
    "game-reports": "SERVICE=game-reports run-s service:*",
    "athletic-feeds": "SERVICE=athletic-feeds run-s service:*",
    "service:clean": "del ./out",
    "service:build": "run-s build",
    "service:prune": "turbo prune @groton/$SERVICE --use-gitignore=false",
    "service:deploy": "./scripts/deploy $SERVICE -v",
    "gcp-build": "turbo build",
    "start": "turbo start --env-mode=loose",
    "release": "turbo --concurrency 1 release"
  },
  "dependencies": {
    "turbo": "^2.11.10"
  },
  "devDependencies": {
    "@1password/sdk": "^0.5.0",
    "@battis/commit": "^0.0.11",
    "@battis/descriptive-types": "^0.3.1",
    "@battis/eslint": "^3.0.8",
    "@battis/monorepo": "^1.0.0",
    "@battis/partly-gcloudy": "^3.4.5",
    "@battis/prettier": "^2.0.11",
    "@qui-cli/env": "^5.3.0",
    "@qui-cli/structured": "^2.0.7",
    "@tsconfig/node-lts": "catalog:dev",
    "@types/node": "catalog:dev",
    "change-case": "^5.4.4",
    "del-cli": "catalog:dev",
    "eslint-config-next": "16.3.2",
    "npm-run-all": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
